---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { counters } from '../content/site';

const aboutChecks = [
  '100% Legal Clearances',
  'Premium farm land communities',
  'Authority approved residential layouts',
  'Resort and leisure-oriented developments',
];
import about1 from '../assets/images/about-1.jpg'; // [REPLACE]
import about2 from '../assets/images/about-2.jpg'; // [REPLACE]
---
<section id="about" aria-labelledby="about-title" class="py-20 sm:py-28">
  <div class="container-x grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
    <!-- Overlapping collage -->
    <div class="reveal relative mx-auto w-full max-w-lg pb-16 pr-10 sm:pr-16 lg:mx-0">
      <Picture src={about1} formats={['avif', 'webp']} widths={[400, 640, 900]} sizes="(min-width: 1024px) 460px, 85vw"
        quality={62} alt="Rows of coconut trees on Kyra farmland" class="media aspect-[4/5] w-full object-cover" pictureAttributes={{ class: 'block' }} />
      <Picture src={about2} formats={['avif', 'webp']} widths={[320, 520]} sizes="(min-width: 1024px) 280px, 50vw"
        quality={62} alt="Kyra team walking a family through a farm"
        class="media aspect-[4/3] w-full object-cover"
        pictureAttributes={{ class: 'absolute bottom-0 right-0 block w-[58%] rounded-[20px] border-[6px] border-surface shadow-xl' }} />
      <div class="absolute top-6 -left-2 rounded-2xl bg-brand px-5 py-4 text-white shadow-lg sm:-left-6">
        <p class="font-display text-3xl leading-none">Since 2016</p>
        <p class="mt-1 text-sm text-white/80">Coimbatore based</p>
      </div>
    </div>

    <div class="reveal">
      <p class="eyebrow mb-3">About Us</p>
      <h2 id="about-title" class="mb-6">Kyra Group – What We Offer</h2>
      <p class="measure mb-4 text-ink-muted">
        Kyra Group creates thoughtfully developed land communities designed for secure ownership, infrastructure readiness, and long-term value appreciation.
      </p>
      <p class="measure mb-6 text-ink-muted">
        With a development journey that began in 2016 and a renewed corporate identity established in 2026, Kyra Group represents the evolution of disciplined real estate expertise into a professionally managed, future-focused development brand.
      </p>
      <ul class="mb-8 grid gap-2.5">
        {aboutChecks.map((c) => (
          <li class="flex items-center gap-3 font-semibold text-ink">
            <span class="grid size-6 shrink-0 place-items-center rounded-full bg-brand text-white"><Icon name="check" size={14} /></span>{c}
          </li>
        ))}
      </ul>

      <dl class="mb-9 grid grid-cols-3 gap-x-6 border-y border-[#d6e1da] py-8">
        {counters.map((c) => (
          <div>
            <dt class="text-sm text-ink-muted">{c.label}</dt>
            <dd class="font-display text-[clamp(1.7rem,6.5vw,2.25rem)] whitespace-nowrap text-brand" data-count={c.value} data-suffix={c.suffix}>
              {c.value.toLocaleString('en-IN')}{c.suffix}
            </dd>
          </div>
        ))}
      </dl>

      <button type="button" class="btn btn-green" data-open-lead data-intent="callback" data-track="about">
        Talk to our team <Icon name="arrow-right" size={18} />
      </button>
    </div>
  </div>
</section>

<style>
  /* Number above its label while keeping <dt> first in the DOM for screen readers */
  dl > div { display: flex; flex-direction: column-reverse; gap: .25rem; }
</style>
