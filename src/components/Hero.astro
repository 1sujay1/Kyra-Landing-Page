---
import { Picture } from 'astro:assets';
import LeadForm from './LeadForm.astro';
import Icon from './Icon.astro';
import { trust } from '../content/site';
import hero from '../assets/images/hero.jpg'; // [REPLACE] real hero photo (≥1920px wide, landscape)
---
<section id="home" aria-labelledby="hero-title" class="relative isolate flex min-h-[100svh] items-center overflow-hidden text-white">
  <div id="top-sentinel" class="absolute top-0 h-[600px] w-px" aria-hidden="true"></div>

  <div class="absolute inset-0 -z-10 overflow-hidden">
    <Picture
      src={hero}
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1920]}
      sizes="100vw"
      quality={60}
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="kenburns h-full w-full object-cover"
      pictureAttributes={{ class: 'block h-full w-full' }}
    />
    <!-- Dark green gradient for text contrast -->
    <div class="absolute inset-0 bg-[linear-gradient(100deg,rgb(11_33_20/.92)_0%,rgb(20_55_33/.78)_45%,rgb(20_55_33/.35)_100%)]"></div>
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-[rgb(11_33_20/.7)] to-transparent"></div>
  </div>

  <div class="container-x grid items-center gap-10 pt-[calc(var(--header-h)+2.5rem)] pb-16 lg:grid-cols-[1.15fr_0.85fr] lg:gap-14 lg:pb-20">
    <div class="hero-rise on-dark max-w-2xl">
      <p class="tamil mb-4 text-[1.05rem] leading-relaxed text-gold sm:text-lg" lang="ta">
        கோயம்புத்தூர் அருகே உங்கள் சொந்த பண்ணை நிலம்
      </p>
      <h1 id="hero-title" class="mb-5">
        Own farmland near Coimbatore, close to the city, surrounded by green hills
      </h1>
      <p class="measure mb-8 text-lg text-white/90 sm:text-xl">
        Clear-title farmland plots near Pollachi with road access, water source and fencing. Visit the site this weekend with free pickup.
      </p>
      <div class="flex flex-col gap-3 xs:flex-row">
        <button type="button" class="btn btn-gold text-[1.05rem]" data-open-lead data-intent="site_visit" data-track="hero">
          Book a free site visit <Icon name="arrow-right" size={18} />
        </button>
        <button type="button" class="btn btn-ghost-light text-[1.05rem]" data-open-lead data-intent="price" data-track="hero">
          Get price details
        </button>
      </div>
      <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-3 border-t border-white/20 pt-6 text-sm sm:text-[0.95rem]" aria-label="Why Kyra Group">
        {trust.map((t) => (
          <li class="flex items-center gap-2">
            <span class="grid size-6 place-items-center rounded-full bg-gold/20 text-gold"><Icon name="check" size={14} /></span>
            <span><strong class="font-bold text-white">{t.value}</strong> <span class="text-white/80">{t.label}</span></span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Desktop: inline short lead form. Mobile uses the popup instead. -->
    <div class="card hidden p-7 text-ink lg:block xl:p-8" style="animation: rise .9s .35s var(--ease-out) both">
      <h2 class="mb-1 !text-[1.75rem]">Book a free site visit</h2>
      <p class="mb-5 text-[0.95rem] text-ink-muted">Free pickup from Coimbatore. We call you back within 30 minutes.</p>
      <LeadForm id="hero" dense />
    </div>
  </div>
</section>
