---
import { Picture } from 'astro:assets';
import LeadForm from './LeadForm.astro';
import Icon from './Icon.astro';
import { heroLocation, trust } from '../content/site';
import hero from '../assets/images/hero.jpg'; // [REPLACE] real hero photo (≥1920px wide, landscape)
---
<section id="home" aria-labelledby="hero-title" class="relative isolate flex min-h-[100svh] items-center overflow-hidden text-white">
  <div id="top-sentinel" class="absolute top-0 h-[600px] w-px" aria-hidden="true"></div>

  <div class="absolute inset-0 -z-10 overflow-hidden">
    <Picture
      src={hero}
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1920]}
      sizes="100vw"
      quality={60}
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="kenburns h-full w-full object-cover"
      pictureAttributes={{ class: 'block h-full w-full' }}
    />
    <!-- Dark green gradient for text contrast -->
    <div class="absolute inset-0 bg-[linear-gradient(100deg,rgb(11_33_20/.92)_0%,rgb(20_55_33/.78)_45%,rgb(20_55_33/.35)_100%)]"></div>
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-[rgb(11_33_20/.7)] to-transparent"></div>
  </div>

  <div class="container-x grid items-center gap-10 pt-[calc(var(--header-h)+2.5rem)] pb-16 lg:grid-cols-[1.15fr_0.85fr] lg:gap-14 lg:pb-20">
    <div class="hero-rise on-dark max-w-2xl">
      <h1 id="hero-title" class="mb-6 grid gap-2.5">
        <span class="font-sans text-[clamp(1.05rem,1.5vw,1.3rem)] leading-snug font-semibold tracking-[0.01em] text-gold">
          Own a piece of nature farm, close to Coimbatore
        </span>
        <span class="tamil text-[clamp(1.85rem,4.4vw,3.5rem)] leading-[1.3] text-white" lang="ta">
          கோவைக்கு அருகில் உங்கள் சொந்த பண்ணை நிலம்
        </span>
      </h1>
      <ul class="mb-8 grid gap-2 text-[clamp(0.98rem,1.2vw,1.08rem)] text-white/90" aria-label="Location">
        {heroLocation.map((l) => (
          <li class="flex items-start gap-2.5"><Icon name="map-pin" size={18} class="mt-0.5 shrink-0 text-gold" />{l}</li>
        ))}
      </ul>
      <div class="flex flex-col gap-3 xs:flex-row">
        <button type="button" class="btn btn-gold text-[1.05rem]" data-open-lead data-intent="site_visit" data-track="hero">
          Plan your farm visit <Icon name="arrow-right" size={18} />
        </button>
        <button type="button" class="btn btn-ghost-light text-[1.05rem]" data-open-lead data-intent="price" data-track="hero">
          Get price details
        </button>
      </div>
      <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3 border-t border-white/20 pt-5 text-[0.95rem] text-white/85">
        <p>A new vision, backed by <strong class="font-bold text-white">{trust.years}</strong> of experience</p>
        <p class="rounded-full border border-gold/55 bg-gold/15 px-3.5 py-1"><strong class="font-bold text-white">{trust.customers}</strong> happy customers</p>
      </div>
    </div>

    <!-- Desktop: inline short lead form. Mobile uses the popup instead. -->
    <div class="card hidden p-7 text-ink lg:block xl:p-8" style="animation: rise .9s .35s var(--ease-out) both">
      <h2 class="mb-1 !text-[1.75rem]">Plan your farm visit</h2>
      <p class="mb-5 text-[0.95rem] text-ink-muted">Complimentary pick-up from our office. Our team will connect with you shortly.</p>
      <LeadForm id="hero" dense />
    </div>
  </div>
</section>
