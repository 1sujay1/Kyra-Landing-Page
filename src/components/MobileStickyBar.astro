---
import Icon from './Icon.astro';
import { site, whatsappLink } from '../content/site';
---
<nav id="mobile-bar" aria-label="Quick actions"
  class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-[1fr_1fr_1.4fr] gap-2 border-t border-black/5 bg-white/95 px-3 pt-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] shadow-[0_-8px_30px_-12px_rgb(0_0_0/.25)] backdrop-blur md:hidden data-[hidden]:hidden">
  <a href={`tel:${site.phone}`} class="flex min-h-12 flex-col items-center justify-center rounded-xl text-xs font-bold text-brand" data-track="sticky_bar">
    <Icon name="phone" size={20} /> Call
  </a>
  <a href={whatsappLink()} target="_blank" rel="noopener" class="flex min-h-12 flex-col items-center justify-center rounded-xl text-xs font-bold text-[#1f7a43]" data-track="sticky_bar">
    <Icon name="whatsapp" size={22} /> WhatsApp
  </a>
  <button type="button" class="btn btn-gold !min-h-12 !px-3 text-[0.95rem]" data-open-lead data-intent="site_visit" data-track="sticky_bar">
    Book visit
  </button>
</nav>
