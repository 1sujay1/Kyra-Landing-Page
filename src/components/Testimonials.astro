---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import { testimonials } from '../content/testimonials';

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/images/testimonials/*.{jpg,jpeg,png,webp}', { eager: true });
const photo = (f: string) => {
  const m = photos[`../assets/images/testimonials/${f}`];
  if (!m) throw new Error(`Testimonial photo not found: src/assets/images/testimonials/${f}`);
  return m.default;
};
---
<section id="testimonials" aria-labelledby="testimonials-title" class="py-20 sm:py-28">
  <div class="container-x" data-carousel>
    <div class="reveal mb-10 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="eyebrow mb-3">Testimonials</p>
        <h2 id="testimonials-title">Families who already own a piece of the hills</h2>
      </div>
      <div class="flex gap-3">
        <button type="button" data-prev class="grid size-12 place-items-center rounded-full border border-brand text-brand transition-colors hover:bg-brand hover:text-white" aria-label="Previous testimonial">
          <Icon name="arrow-left" size={20} />
        </button>
        <button type="button" data-next class="grid size-12 place-items-center rounded-full border border-brand text-brand transition-colors hover:bg-brand hover:text-white" aria-label="Next testimonial">
          <Icon name="arrow-right" size={20} />
        </button>
      </div>
    </div>

    <div class="reveal carousel-track -mx-2" role="region" aria-roledescription="carousel" aria-label="Customer testimonials" tabindex="0">
      {testimonials.map((t, i) => (
        <article class="px-2" aria-roledescription="slide" aria-label={`${i + 1} of ${testimonials.length}`}>
          <figure class="card flex h-full flex-col p-7 sm:p-9">
            <div class="mb-5 flex gap-1 text-gold" role="img" aria-label={`Rated ${t.rating} out of 5`}>
              {Array.from({ length: 5 }, (_, s) => (
                <Icon name="star" size={18} class={s < t.rating ? 'fill-current' : 'text-[#cdd6d0]'} />
              ))}
            </div>
            <blockquote class="mb-7 flex-1 font-display text-xl leading-relaxed sm:text-[1.4rem]">
              <p>“{t.quote}”</p>
            </blockquote>
            <figcaption class="flex items-center gap-4">
              <Image src={photo(t.photo)} width={56} height={56} densities={[1, 2]} alt="" loading="lazy" class="size-14 rounded-full object-cover" />
              <span class="flex-1">
                <span class="block font-bold">{t.name}</span>
                <span class="text-sm text-ink-muted">{t.city}</span>
              </span>
              {t.youtubeId && (
                <a href={`https://www.youtube.com/watch?v=${t.youtubeId}`} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-sm font-bold text-brand-2 underline">
                  <Icon name="play" size={14} /> Watch their story
                </a>
              )}
            </figcaption>
          </figure>
        </article>
      ))}
    </div>

    <div class="mt-6 flex justify-center gap-1" role="group" aria-label="Choose testimonial">
      {testimonials.map((t, i) => (
        <button type="button" class="dot-btn" data-dot aria-label={`Show testimonial from ${t.name}`} aria-current={i === 0 ? 'true' : 'false'}>
          <span class="dot"></span>
        </button>
      ))}
    </div>
  </div>
</section>
