---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { distances, highlights, site } from '../content/site';
import mapFacade from '../assets/images/map-facade.jpg'; // [REPLACE] a screenshot of the map / site plan
---
<section id="highlights" aria-labelledby="highlights-title" class="bg-brand py-20 text-white sm:py-28 on-dark">
  <div class="container-x">
    <div class="reveal mb-12 grid gap-6 lg:grid-cols-[1fr_auto] lg:items-end">
      <div>
        <p class="eyebrow mb-3">Project highlights</p>
        <h2 id="highlights-title" class="max-w-2xl">Everything checked before you even visit</h2>
      </div>
      <button type="button" class="btn btn-gold justify-self-start" data-open-lead data-intent="brochure" data-track="highlights">
        <Icon name="download" size={18} /> Download brochure
      </button>
    </div>

    <!-- Bento grid: two wide feature tiles, four compact ones -->
    <ul class="reveal grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {highlights.map((h) => (
        <li class:list={[
          'rounded-[20px] p-6 sm:p-7',
          h.wide ? 'bg-white/[0.08] ring-1 ring-white/15 lg:col-span-2' : 'bg-white/[0.04] ring-1 ring-white/10',
        ]}>
          <span class="mb-5 grid size-12 place-items-center rounded-xl bg-gold text-brand">
            <Icon name={h.icon} size={24} />
          </span>
          <h3 class:list={['mb-2', h.wide && 'sm:text-2xl']}>{h.title}</h3>
          <p class="text-[0.95rem] text-white/75">{h.text}</p>
        </li>
      ))}
    </ul>

    <!-- Location: distance list + lazy map -->
    <div class="reveal mt-16 grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:gap-12">
      <div>
        <h3 class="mb-2 text-2xl sm:text-3xl">Location advantages</h3>
        <p class="mb-6 text-white/75">Approximate distances by road from the project site.</p>
        <ol class="divide-y divide-white/10 border-y border-white/10">
          {distances.map((d) => (
            <li class="flex items-center justify-between gap-4 py-4">
              <span class="flex items-center gap-3"><Icon name="map-pin" size={20} class="shrink-0 text-gold" />{d.place}</span>
              <span class="text-right"><strong class="block font-display text-xl font-normal">{d.distance}</strong><span class="text-sm text-white/65">{d.time}</span></span>
            </li>
          ))}
        </ol>
      </div>
      <div id="map-facade" data-src={site.mapEmbedUrl} class="relative min-h-[320px] overflow-hidden rounded-[20px] bg-[#0f2b1a] lg:min-h-full">
        <Picture src={mapFacade} formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 640px, 100vw"
          quality={55} alt="" class="absolute inset-0 h-full w-full object-cover opacity-55" pictureAttributes={{ class: 'contents' }} />
        <div class="absolute inset-0 grid place-items-center p-6 text-center">
          <div>
            <span class="mx-auto mb-4 grid size-14 place-items-center rounded-full bg-gold text-brand"><Icon name="map-pin" size={26} /></span>
            <button type="button" class="btn btn-ghost-light bg-black/30">Show map</button>
            <p class="mt-3 text-xs text-white/75">Loads Google Maps, which may set cookies.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
